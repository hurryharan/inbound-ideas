DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inbound_ideas?schema=public"
# Direct (non-pooled) connection, used only for running migrations
# (`prisma migrate deploy`/`dev`). If your Postgres has no separate pooled
# connection (e.g. local Postgres, Docker), set this to the same value as
# DATABASE_URL. If it's Neon, this is the same connection string but with
# "-pooler" removed from the hostname (Neon dashboard → Connect → toggle
# off "Connection pooling" to get it directly). Required whenever a migrate
# command runs — Prisma has no implicit fallback if it's unset.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inbound_ideas?schema=public"

# Single-user auth. Set a strong password; SESSION_SECRET signs the session cookie
# (any long random string).
APP_PASSWORD="change-me"
SESSION_SECRET="change-me-to-a-long-random-string"

# Encrypts LLM API keys and Google OAuth tokens at rest. Must decode to exactly
# 32 bytes. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Identifies the single user row (also used for attribution). Optional —
# defaults to sysadmin@ispirt.in if unset.
APP_USER_EMAIL=""

# Google OAuth (read-only Drive + Sheets scopes) — required to connect
# Context sources (Google Drive folders/docs) and Google Sheet inbound sources.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type "Web application") and enable the Drive API + Sheets API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/context/google/callback"

# Optional — the app works without any LLM provider configured (ideas are
# generated with a built-in heuristic). Add keys via Settings > LLM in the
# UI, or set these to have them available at deploy time.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
