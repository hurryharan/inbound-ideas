// Inbound Ideas — Prisma schema
// See PRD section 34 (Database Entities) for the model this implements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — `migrate deploy`
  // takes a session-level advisory lock, which doesn't work reliably
  // through a pooled/pgbouncer-style connection (this is why Neon's
  // "-pooler" DATABASE_URL alone causes `migrate deploy` to time out
  // waiting on pg_advisory_lock). Set DIRECT_URL to the same value as
  // DATABASE_URL for a plain (non-pooled) Postgres instance — it must be
  // set to *something* whenever migrate commands run, Prisma has no
  // implicit fallback for an unresolvable directUrl.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  preferences   UserPreference[]
  llmProviders  LLMProvider[]
  sources       Source[]
  contextSources ContextSource[]
  llmUsageEvents LLMUsageEvent[]
}

// ─────────────────────────────────────────────────────────────────────────
// Sources (section 14, 24) — abstraction over inbound material producers.
// Every Source is a Google Sheet: the user (or a periodic export from
// LinkedIn/Twitter/wherever) populates rows into a sheet, and this app
// reads it read-only. The Source's `name` is what distinguishes "LinkedIn
// Saved Posts" from "Content Ideas" — there is no separate connector type.
// ─────────────────────────────────────────────────────────────────────────

enum SourcePriority {
  LOW
  MEDIUM
  HIGH
}

model Source {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  enabled          Boolean        @default(true)
  // { spreadsheetId, spreadsheetUrl, sheetName, columnMapping? } — columnMapping
  // is auto-detected from the header row on first refresh if omitted.
  config           Json           @default("{}")
  tags             String[]       @default([])
  priority         SourcePriority @default(MEDIUM)
  refreshFrequencyMinutes Int     @default(1440)
  lastRefreshedAt  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items SourceItem[]

  @@index([userId])
}

model SourceItem {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId  String // stable id/url from the origin system, used for de-dup
  title       String
  content     String
  url         String?
  author      String?
  contentHash String // sha256 of normalized content, used for de-dup
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) // when the item originated (e.g. saved on LinkedIn)
  importedAt  DateTime @default(now())

  ideaLinks IdeaSourceItem[]

  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([sourceId])
}

// ─────────────────────────────────────────────────────────────────────────
// Context layer (section 10, 11, 12, 20, 25)
// ─────────────────────────────────────────────────────────────────────────

enum ContextSourceType {
  GOOGLE_DRIVE_DOCUMENT
  GOOGLE_DRIVE_FOLDER
  GOOGLE_SHEET
}

model ContextSource {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  type         ContextSourceType
  externalId   String // Google Drive file/folder id or Sheet id
  url          String?
  tags         String[]          @default([])
  priority     SourcePriority    @default(MEDIUM)
  instructions String?
  enabled      Boolean           @default(true)
  lastIndexedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  documents ContextDocument[]

  @@index([userId])
}

model ContextDocument {
  id              String        @id @default(cuid())
  contextSourceId String
  contextSource   ContextSource @relation(fields: [contextSourceId], references: [id], onDelete: Cascade)
  externalId      String
  title           String
  content         String
  url             String?
  tags            String[]      @default([])
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())

  ideaLinks IdeaContextDocument[]

  @@unique([contextSourceId, externalId])
  @@index([contextSourceId])
}

// ─────────────────────────────────────────────────────────────────────────
// Ideas (section 15, 16, 9)
// ─────────────────────────────────────────────────────────────────────────

enum IdeaStatus {
  NEW
  SURFACED
  EXPLORING
  EXPLORED
  PARKED
  ARCHIVED
}

model Idea {
  id               String     @id @default(cuid())
  title            String
  summary          String
  observation      String
  whyRelevant      String
  potentialThesis  String
  angles           Json       @default("[]") // Angle[] — { label, description }
  topics           String[]   @default([])
  score            Float      @default(0)
  status           IdeaStatus @default(NEW)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  lastExploredAt   DateTime?

  sourceItems      IdeaSourceItem[]
  contextDocuments IdeaContextDocument[]
  sessions         Session[]
  feedback         Feedback[]

  @@index([status])
  @@index([score])
}

model IdeaSourceItem {
  ideaId       String
  idea         Idea       @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  sourceItemId String
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@id([ideaId, sourceItemId])
}

model IdeaContextDocument {
  ideaId            String
  idea              Idea            @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  contextDocumentId String
  contextDocument   ContextDocument @relation(fields: [contextDocumentId], references: [id], onDelete: Cascade)
  relevance         Float           @default(0)

  @@id([ideaId, contextDocumentId])
}

enum FeedbackSignal {
  INTERESTING
  NOT_INTERESTING
  EXPLORE
  PARK
  ARCHIVE
}

model Feedback {
  id        String         @id @default(cuid())
  ideaId    String
  idea      Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  signal    FeedbackSignal
  createdAt DateTime       @default(now())

  @@index([ideaId])
}

// ─────────────────────────────────────────────────────────────────────────
// LLM providers (section 17, 26) and ideation sessions (section 21, 22)
// ─────────────────────────────────────────────────────────────────────────

enum LLMProviderKind {
  OPENAI
  ANTHROPIC
  GOOGLE
  OPENAI_COMPATIBLE
}

model LLMProvider {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           LLMProviderKind
  name           String
  // Encrypted at rest — see src/lib/crypto.ts. Never returned to the client.
  apiKeyEncrypted String?
  baseUrl        String?
  defaultModel   String
  temperature    Float?          @default(0.7)
  maxTokens      Int?            @default(2048)
  systemPrompt   String?
  isDefault      Boolean         @default(false)
  // USD per 1M tokens, user-supplied (auto-suggested for known Anthropic
  // models). Null means cost isn't computed for this provider's calls —
  // usage/tokens are still recorded either way.
  inputPricePerMillion  Float?
  outputPricePerMillion Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  sessions    Session[]
  usageEvents LLMUsageEvent[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// LLM usage/cost accounting — one row per completed LLM API call, tagged
// with which workflow triggered it (today: idea generation) so spend is
// attributable both by provider and by use case.
// ─────────────────────────────────────────────────────────────────────────

enum LLMWorkflow {
  IDEA_GENERATION
}

model LLMUsageEvent {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmProviderId String?
  llmProvider   LLMProvider?    @relation(fields: [llmProviderId], references: [id], onDelete: SetNull)
  // Denormalized so provider/kind-level rollups survive the provider being edited or deleted.
  providerKind  LLMProviderKind
  providerName  String
  model         String
  workflow      LLMWorkflow
  inputTokens   Int
  outputTokens  Int
  // Null when the provider had no pricing configured at call time.
  costUsd       Float?
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([workflow])
  @@index([llmProviderId])
  @@index([createdAt])
}

enum SessionStatus {
  STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Session {
  id                String        @id @default(cuid())
  ideaId            String
  idea              Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  llmProviderId     String?
  llmProvider       LLMProvider?  @relation(fields: [llmProviderId], references: [id], onDelete: SetNull)
  llmModel          String
  startedAt         DateTime      @default(now())
  externalChatUrl   String?
  status            SessionStatus @default(STARTED)
  notes             String?
  promptText        String // the generated launch prompt, always preserved
  contextDocumentIds String[]     @default([]) // audit trail: which context docs were included

  @@index([ideaId])
}

// ─────────────────────────────────────────────────────────────────────────
// User preferences (section 16 ranking weights, 19/27 ideation prompt, 23 general)
// ─────────────────────────────────────────────────────────────────────────

model UserPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  @@unique([userId, key])
}
